{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix hotel-owner-stich-project install",
  "buildCommand": "npm run build",
  "outputDirectory": "hotel-owner-stich-project/dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "hotel-owner-stich-project/server/data.json",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/index?route=:route*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
